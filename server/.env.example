# Server configuration
PORT=5000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<your_username>:<your_password>@cluster0.xxxxx.mongodb.net/garagecare?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173
